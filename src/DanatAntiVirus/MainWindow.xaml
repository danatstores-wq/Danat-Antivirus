<Window x:Class="DanatAntiVirus.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Danat Anti-Virus" Height="760" Width="1120" MinHeight="650" MinWidth="940" WindowStartupLocation="CenterScreen" Background="#FF090909" Foreground="#FFF5E9C8">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="#FF191919"/><Setter Property="Foreground" Value="#FFE9D49A"/><Setter Property="BorderBrush" Value="#FF3A301B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#FF111111" BorderBrush="#FF302714" BorderThickness="0,0,1,0" Padding="20"><DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <Border Width="76" Height="76" CornerRadius="38" BorderBrush="#FFD6A62E" BorderThickness="2" Background="#FF201A0B" HorizontalAlignment="Left" Margin="0,4,0,14"><TextBlock Text="D" FontSize="49" FontWeight="Bold" Foreground="#FFFFD56A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="DANAT" FontSize="22" FontWeight="Bold" Foreground="#FFFFD56A"/><TextBlock Text="ANTI-VIRUS" FontSize="12" Foreground="#FFB9A36D" Margin="0,0,0,30"/>
    <Button Style="{StaticResource NavButton}" Content="◈   Dashboard"/><Button Style="{StaticResource NavButton}" Content="⌕   Scan computer" IsEnabled="False"/><Button Style="{StaticResource NavButton}" Content="▣   Quarantine" IsEnabled="False"/><Button Style="{StaticResource NavButton}" Content="↻   Updates" IsEnabled="False"/><Button Style="{StaticResource NavButton}" Content="⚙   Settings" IsEnabled="False"/>
   </StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="VERSION 0.3 • ENGINE INTEGRATION" Foreground="#FF887B59" FontSize="10"/><TextBlock Text="Uses Microsoft Defender Antivirus" Foreground="#FFB9A36D" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  </DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28,34,34">
   <DockPanel><StackPanel><TextBlock Text="SECURITY CENTER" Foreground="#FFD6A62E" FontSize="12" FontWeight="Bold"/><TextBlock Text="Your digital fortress" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#FF241D0E" BorderBrush="#FF6F5420" BorderThickness="1" CornerRadius="14" Padding="13,8" VerticalAlignment="Center"><TextBlock Text="ENGINE INTEGRATION" Foreground="#FFFFD56A" FontSize="11" FontWeight="Bold"/></Border></DockPanel>
   <Border Background="#FF17130B" BorderBrush="#FF72551C" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,26,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="DANAT ANTI-VIRUS" Foreground="#FFFFD56A" FontSize="13" FontWeight="Bold"/><TextBlock Text="Windows Defender integration" FontSize="25" FontWeight="SemiBold" Margin="0,8"/><TextBlock Text="Danat now checks and launches the Microsoft Defender Antivirus engine already installed in Windows. Defender remains responsible for real-time protection and its own security updates." Foreground="#FFC5B995" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/><TextBlock Text="IMPORTANT: DANAT DOES NOT REPLACE MICROSOFT DEFENDER" Foreground="#FFFFC65C" FontSize="11" FontWeight="Bold" Margin="0,16,0,0"/></StackPanel>
    <Border Grid.Column="1" Width="174" Height="174" CornerRadius="87" BorderBrush="#FFD6A62E" BorderThickness="3" Background="#FF0C0B08" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Ellipse Margin="9" Stroke="#FF5E471B" StrokeThickness="1"/><TextBlock Text="D" FontSize="114" FontWeight="Bold" Foreground="#FFFFD56A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
   </Grid></Border>
   <TextBlock Text="MICROSOFT DEFENDER STATUS" Foreground="#FFD6A62E" FontWeight="Bold" FontSize="12" Margin="0,10,0,12"/>
   <Border Background="#FF171717" BorderBrush="#FF72551C" BorderThickness="1" CornerRadius="12" Padding="18">
    <StackPanel>
     <TextBlock Text="Live protection status from Windows" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="DefenderStatusText" Text="Checking Microsoft Defender status…" Foreground="#FFFFC65C" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,8"/>
     <TextBlock x:Name="SignatureAgeText" Text="Checking security intelligence age…" Foreground="#FFC5B995" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button x:Name="RefreshStatusButton" Content="REFRESH DEFENDER STATUS" Click="RefreshStatus_Click" HorizontalAlignment="Left" Padding="16,9" Background="#FF302820" Foreground="#FFE9D49A" BorderBrush="#FF72551C"/>
    </StackPanel>
   </Border>
   <TextBlock Text="ON-DEMAND MALWARE SCAN" Foreground="#FFD6A62E" FontWeight="Bold" FontSize="12" Margin="0,22,0,12"/>
   <Border Background="#FF171717" BorderBrush="#FF72551C" BorderThickness="1" CornerRadius="12" Padding="18">
    <StackPanel>
     <TextBlock Text="Scan using Microsoft Defender Antivirus" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Choose a folder and Danat will start a genuine Microsoft Defender custom scan. The scan is configured with DisableRemediation: detected files are not automatically changed by this request. Review scan output and Windows Security → Protection history." Foreground="#FFC5B995" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,14"/>
     <DockPanel Margin="0,0,0,14"><TextBlock Text="File or folder to scan" Foreground="#FFE9D49A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><Button x:Name="ChooseFolderButton" Content="Choose folder…" Click="ChooseFolder_Click" DockPanel.Dock="Right" Padding="12,6" Background="#FF3A2D12" Foreground="#FFFFD56A" BorderBrush="#FF72551C"/></DockPanel>
     <TextBlock x:Name="TargetFolderText" Text="No scan target selected." Foreground="#FFAAA08A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button x:Name="StartScanButton" Content="SCAN WITH MICROSOFT DEFENDER" Click="StartScan_Click" HorizontalAlignment="Left" Padding="18,10" Background="#FFD6A62E" Foreground="#FF17120A" BorderBrush="#FFFFD56A" FontWeight="Bold"/>
     <TextBlock x:Name="ScanStatusText" Text="Ready. Microsoft Defender status has not yet been verified." Foreground="#FFFFC65C" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,14,0,8"/>
     <TextBox x:Name="ScanLogBox" Height="145" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#FF0D0D0D" Foreground="#FFE8DDBB" BorderBrush="#FF37302A" Padding="8"/>
    </StackPanel>
   </Border>
   <Border Background="#FF171717" BorderBrush="#FF37302A" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock Text="CURRENT LIMITATIONS" Foreground="#FFD6A62E" FontSize="12" FontWeight="Bold"/><TextBlock Text="This version is a Microsoft Defender controller, not a separate antivirus engine. It does not install or replace Defender, provide its own real-time file-system driver, quarantine manager, ransomware behavior engine, or subscription service. Microsoft Defender must remain enabled and up to date. Windows 7 is not supported by this integration." Foreground="#FFC5B995" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
