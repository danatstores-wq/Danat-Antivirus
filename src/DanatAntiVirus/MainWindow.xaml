<Window x:Class="DanatAntiVirus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danat Anti-Virus" Height="768" Width="1376" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#FF090909" Foreground="#FFF5E9C8">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Background" Value="#FF171717"/>
            <Setter Property="Foreground" Value="#FFE9D49A"/>
            <Setter Property="BorderBrush" Value="#FF79602B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="#FFD7AA36"/>
            <Setter Property="Foreground" Value="#FF17120A"/>
            <Setter Property="BorderBrush" Value="#FFFFD76A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF211D16"/>
            <Setter Property="Foreground" Value="#FFFFD56A"/>
            <Setter Property="BorderBrush" Value="#FF79602B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Background="#FF111111" BorderBrush="#FF3A2D16" BorderThickness="0,0,1,0" Padding="16,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="66" Height="66" CornerRadius="33" BorderBrush="#FFE2B84F" BorderThickness="2"
                            Background="#FF1B170E" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Image Source="/DanatAntiVirus;component/worrier.png" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
                    </Border>
                    <TextBlock Text="DANAT" FontSize="20" FontWeight="Bold" Foreground="#FFFFD56A"/>
                    <TextBlock Text="ANTI-VIRUS" FontSize="10" Foreground="#FFC6B27C" Margin="0,0,0,28"/>
                    <Button Style="{StaticResource NavButton}" Content="✧   Dashboard" Background="#FF4A3918" BorderBrush="#FFD8AD45"/>
                    <Button Style="{StaticResource NavButton}" Content="⌕   Scan computer" Click="ChooseFolder_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="▣   Quarantine" IsEnabled="False" Opacity="0.7"/>
                    <Button Style="{StaticResource NavButton}" Content="↻   Updates" IsEnabled="False" Opacity="0.7"/>
                    <Button Style="{StaticResource NavButton}" Content="⚙   Settings" IsEnabled="False" Opacity="0.7"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="VERSION 0.4 • PREVIEW BUILD" Foreground="#FF8D805F" FontSize="9"/>
                    <TextBlock Text="Powered by Microsoft Defender" Foreground="#FFB9A36D" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main dashboard -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,32,26">
                <DockPanel LastChildFill="True" Margin="0,0,0,15">
                    <Border DockPanel.Dock="Right" Background="#FF332814" BorderBrush="#FF9D7B32" BorderThickness="1"
                            CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="● PREVIEW BUILD" Foreground="#FFFFD56A" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="YOUR DIGITAL FORTRESS" FontSize="31" FontWeight="Bold" Foreground="#FFFFE5A0"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Two-column dashboard: status and scan on the left, full-height warrior artwork on the right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.75*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <!-- Protection status box -->
                        <Border Background="#FF17130B" BorderBrush="#FFD1A64A" BorderThickness="1.5" CornerRadius="14"
                                Padding="22" Margin="0,0,0,18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DANAT ANTI-VIRUS" Foreground="#FFFFD56A" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Protection status" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,2"/>
                                <TextBlock Text="Live security status from Microsoft Defender Antivirus." Foreground="#FFC9BEA0"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DefenderStatusText" Text="Checking Microsoft Defender status…"
                                           Foreground="#FFFFC65C" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,13,0,4"/>
                                <TextBlock x:Name="SignatureAgeText" Text="Checking security intelligence age…"
                                           Foreground="#FFC5B995" FontSize="11" TextWrapping="Wrap"/>
                                <Button x:Name="RefreshStatusButton" Content="REFRESH PROTECTION STATUS" Click="RefreshStatus_Click"
                                        Style="{StaticResource DarkButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                <TextBlock Text="RANSOMWARE PROTECTION (CONTROLLED FOLDER ACCESS)"
                                           Foreground="#FFFFD56A" FontSize="11" FontWeight="Bold" Margin="0,18,0,5"/>
                                <TextBlock x:Name="CfaStatusText" Text="Checking Windows Controlled Folder Access…"
                                           Foreground="#FFC5B995" FontSize="11" TextWrapping="Wrap"/>
                                <Button Content="OPEN RANSOMWARE PROTECTION SETTINGS" Click="OpenRansomwareSettings_Click"
                                        Style="{StaticResource DarkButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Actual Defender scan controls -->
                        <Border Background="#FF151515" BorderBrush="#FF72551C" BorderThickness="1"
                                CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="MICROSOFT DEFENDER SCAN" Foreground="#FFFFD56A" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Scan your computer" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,2"/>
                                <TextBlock Text="Choose a file or folder. Run a Microsoft Defender scan or an additional ClamAV on-demand scan when ClamAV is installed."
                                           Foreground="#FFC5B995" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <TextBlock Text="FILE OR FOLDER TO SCAN" Foreground="#FFE9D49A" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="ChooseFolderButton" Content="CHOOSE FOLDER…" Click="ChooseFolder_Click"
                                            DockPanel.Dock="Right" Style="{StaticResource GoldButton}" Padding="13,8"/>
                                    <TextBlock x:Name="TargetFolderText" Text="No scan target selected." Foreground="#FFB9AD8E"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                </DockPanel>
                                <CheckBox x:Name="AllowRemediationCheckBox"
                                          Content="I authorize Microsoft Defender to quarantine or remediate threats found in this scan"
                                          IsChecked="False" Foreground="#FFFFC65C" FontSize="11"
                                          Margin="0,6,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartScanButton" Content="DEFENDER SCAN" Click="StartScan_Click" Style="{StaticResource GoldButton}"/>
                                    <Button x:Name="ClamScanButton" Content="CLAMAV SCAN" Click="ClamScan_Click" Style="{StaticResource DarkButton}" Margin="9,0,0,0"/>
                                    <Button Content="OPEN PROTECTION HISTORY" Click="OpenProtectionHistory_Click"
                                            Style="{StaticResource DarkButton}" Margin="9,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="SetupClamAVButton" Content="SET UP CLAMAV" Click="SetupClamAV_Click"
                                        Style="{StaticResource DarkButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                <TextBlock x:Name="ScanStatusText" Text="Ready. Microsoft Defender status has not yet been verified."
                                           Foreground="#FFFFC65C" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,14,0,8"/>
                                <TextBox x:Name="ScanLogBox" Height="112" IsReadOnly="True" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#FF0B0B0B"
                                         Foreground="#FFE8DDBB" BorderBrush="#FF37302A" Padding="8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Full-height warrior artwork column, aligned with both left-side panels -->
                    <Border Grid.Column="1" Background="#FF11100C" BorderBrush="#FFB88A32" BorderThickness="1.5"
                            CornerRadius="14" Padding="12" ClipToBounds="True">
                        <Grid>
                            <Ellipse Width="340" Height="340" Stroke="#FF5E471B" StrokeThickness="1.5"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="292" Height="292" Stroke="#FFB88A32" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="/DanatAntiVirus;component/worrier.png" Stretch="Uniform"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4"/>
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="8,0,8,12">
                                <TextBlock Text="DANAT ANTI-VIRUS" Foreground="#FFFFD56A" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="DEFENDER ENGINE INTEGRATION" Foreground="#FFE9D49A" FontSize="10"
                                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>


                <!-- Windows maintenance center -->
                <Border Background="#FF17130B" BorderBrush="#FFD1A64A" BorderThickness="1.5" CornerRadius="14"
                        Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="WINDOWS TOOLS &amp; OPTIMIZATION" Foreground="#FFFFD56A"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Safe maintenance shortcuts and built-in Windows repair tools"
                                   FontSize="22" FontWeight="SemiBold" Margin="0,5,0,4"/>
                        <TextBlock Text="Choose a task. Danat explains system-level actions and requests Windows administrator approval only when needed. Cleanup skips files that Windows is using."
                                   Foreground="#FFC5B995" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <UniformGrid Columns="3">
                            <Button Content="CLEAN USER TEMP FILES" Click="CleanTemp_Click"
                                    Style="{StaticResource GoldButton}" Margin="3"/>
                            <Button Content="FLUSH DNS CACHE" Click="FlushDns_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="CHECK DISK (ONLINE)" Click="CheckDisk_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="REPAIR WINDOWS (DISM)" Click="RepairWindows_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="REPAIR SYSTEM FILES (SFC)" Click="RepairSystemFiles_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="STORAGE SETTINGS" Click="OpenStorageSettings_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="STARTUP APPS" Click="OpenStartupSettings_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="NETWORK SETTINGS" Click="OpenNetworkSettings_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                            <Button Content="DRIVE OPTIMIZATION" Click="OpenDriveOptimization_Click"
                                    Style="{StaticResource DarkButton}" Margin="3"/>
                        </UniformGrid>
                        <TextBlock x:Name="MaintenanceStatusText" Text="Ready. No maintenance task is running."
                                   Foreground="#FFFFC65C" FontSize="11" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="3,12,3,6"/>
                        <TextBox x:Name="MaintenanceLogBox" Height="90" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#FF0B0B0B"
                                 Foreground="#FFE8DDBB" BorderBrush="#FF37302A" Padding="8"/>
                        <TextBlock Text="Registry cleaning is intentionally excluded. Deleting registry entries automatically can damage Windows and installed applications. Danat will not make silent registry changes."
                                   Foreground="#FFE6B96A" FontSize="10" TextWrapping="Wrap" Margin="3,10,3,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#FF171717" BorderBrush="#FF37302A" BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="IMPORTANT SECURITY INFORMATION" Foreground="#FFD6A62E" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="This preview is a Microsoft Defender controller, not a separate antivirus engine. It does not install or replace Defender, provide its own real-time file-system driver, ransomware behavior engine, quarantine manager, or subscription service. Microsoft Defender must remain enabled and up to date. ClamAV is separate GPL-2.0 third-party software installed through WinGet; Danat does not bundle, modify, or link to it. Windows 7 is not supported by this integration."
                                   Foreground="#FFC5B995" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>